{
    "name": "featherlight",
    "version": "1.0.3",
    "description": "Enforces character limits on notes, with a live status bar counter showing characters used and remaining.",
    "main": "main.js",
    "scripts": {
        "dev": "node esbuild.config.mjs",
        "build": "tsc -noEmit -skipLibCheck && node esbuild.config.mjs production",
        "lint": "eslint ."
    },
