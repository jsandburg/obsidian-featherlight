{
    "name": "featherlight",
    "version": "1.0.3",
    "description": "Enforces character limits on notes, with a live status bar counter showing characters used and remaining.",
    "main": "main.js",
    "scripts": {
        "dev": "node esbuild.config.mjs",
        "build": "tsc -noEmit -skipLibCheck && node esbuild.config.mjs production"
    },
    "keywords": [
        "obsidian",
        "plugin",
        "featherlight"
    ],
    "author": "Julie Sandburg",
    "license": "MIT",
    "devDependencies": {
        "@codemirror/state": "6.5.0",
        "esbuild": "0.17.3",
        "obsidian": "latest",
        "tslib": "^2.8.1",
        "typescript": "^4.7.4"
    }
}
