    "license": "MIT",
    "devDependencies": {
        "@codemirror/state": "6.5.0",
        "@eslint/js": "^9.39.5",
        "@eslint/json": "^0.14.0",
        "esbuild": "^0.28.2",
        "eslint": "^9.39.5",
        "eslint-plugin-obsidianmd": "^0.4.2",
        "obsidian": "1.13.0",
        "tslib": "^2.8.1",
        "typescript": "^5.9.3",
        "typescript-eslint": "^8.70.1"
    }
}
